/* ===== Global & Variables ===== */
/*
  Primary: #4CAF50 (Green)
  Secondary: #2196F3 (Blue)
  Background: #121212
  Surface: #1E1E1E
  Overlay: #2C2C2C
  Text Main: #E0E0E0
  Text Dim: #9E9E9E
  Border: #333333
*/

QWidget {
    font-family: "Inter", "Segoe UI", "맑은 고딕", sans-serif;
    font-size: 13px;
    color: #E0E0E0;
    outline: none;
}

QMainWindow {
    background-color: #121212;
}

/* ===== Scrollbar (Modern Thin Style) ===== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 5px;
    min-height: 40px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #444444;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #333333;
    border-radius: 5px;
    margin: 2px;
}

/* ===== Menu Bar & Menus ===== */
QMenuBar {
    background-color: #1A1A1A;
    border-bottom: 1px solid #222222;
    color: #B0B0B0;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2C2C2C;
    color: #FFFFFF;
}

QMenu {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 32px 8px 24px;
    border-radius: 4px;
    color: #E0E0E0;
}

QMenu::item:selected {
    background-color: #4CAF50;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 6px 8px;
}

/* ===== Toolbar ===== */
QWidget#toolbar {
    background-color: #1A1A1A;
    border-bottom: 1px solid #222222;
    padding: 4px;
}

QPushButton#pasteButton {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 24px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#pasteButton:hover {
    background-color: #66BB6A;
}

QPushButton#pasteButton:pressed {
    background-color: #388E3C;
    padding-top: 10px;
    padding-bottom: 6px;
}

QLabel#toolbarLabel {
    color: #757575;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    padding-left: 8px;
}

QPushButton#downloadTypeButton,
QPushButton#qualityButton,
QPushButton#formatButton,
QPushButton#savePathButton {
    background-color: #262626;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 12px;
    color: #D0D0D0;
    text-align: left;
}

QPushButton#downloadTypeButton:hover,
QPushButton#qualityButton:hover,
QPushButton#formatButton:hover,
QPushButton#savePathButton:hover {
    background-color: #333333;
    border-color: #4CAF50;
}

QPushButton#downloadTypeButton::menu-indicator,
QPushButton#qualityButton::menu-indicator,
QPushButton#formatButton::menu-indicator,
QPushButton#savePathButton::menu-indicator {
    width: 0;
}

/* ===== Tab Bar ===== */
QWidget#tabBarWidget {
    background-color: #121212;
    border-bottom: 1px solid #222222;
}

QPushButton#tabButton {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 12px 20px;
    color: #757575;
    font-weight: 500;
}

QPushButton#tabButton:hover {
    color: #BDBDBD;
}

QPushButton#tabButton:checked {
    color: #4CAF50;
    border-bottom: 3px solid #4CAF50;
    font-weight: 700;
}

QLineEdit#tabSearchInput {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 15px;
    padding: 5px 15px;
    color: #E0E0E0;
    margin: 4px;
}

QLineEdit#tabSearchInput:focus {
    border-color: #4CAF50;
    background-color: #262626;
}

/* ===== Download List & Item Card ===== */
QScrollArea#downloadScroll {
    border: none;
    background-color: #121212;
}

QWidget#downloadContainer {
    background-color: #121212;
    padding: 8px;
}

QWidget#downloadItem {
    background-color: #1E1E1E;
    border: 1px solid #262626;
    border-radius: 12px;
    margin-bottom: 8px;
}

QWidget#downloadItem:hover {
    background-color: #252525;
    border-color: #383838;
}

QWidget#downloadItem[selected="true"] {
    background-color: #2A2A2A;
    border: 1px solid #4CAF50;
}

QLabel#thumbnail {
    background-color: #000000;
    border-radius: 8px;
}

QLabel#itemTitle {
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#itemMeta {
    font-size: 12px;
    color: #9E9E9E;
}

/* Status Badges */
QLabel#statusBadge {
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: bold;
    color: white;
}

QLabel#statusBadge[status="waiting"] { background-color: #757575; }
QLabel#statusBadge[status="downloading"] { background-color: #2196F3; }
QLabel#statusBadge[status="processing"] { background-color: #FF9800; }
QLabel#statusBadge[status="completed"] { background-color: #4CAF50; }
QLabel#statusBadge[status="error"] { background-color: #F44336; }
QLabel#statusBadge[status="paused"] { background-color: #9C27B0; }

QProgressBar#itemProgress {
    background-color: #333333;
    border: none;
    border-radius: 4px;
    height: 8px;
}

QProgressBar#itemProgress::chunk {
    background-color: #4CAF50;
    border-radius: 4px;
}

QPushButton#itemFolderButton, QPushButton#itemActionButton {
    background-color: #2C2C2C;
    border: 1px solid #383838;
    border-radius: 16px;
    color: #E0E0E0;
}

QPushButton#itemFolderButton:hover {
    background-color: #383838;
    color: #4CAF50;
    border-color: #4CAF50;
}

QPushButton#itemActionButton:hover {
    background-color: #383838;
    color: #F44336;
    border-color: #F44336;
}

/* ===== Control Panel (Side Drawer) ===== */
QWidget#controlPanel {
    background-color: #1E1E1E;
    border-left: 1px solid #333333;
}

QWidget#cpHeader {
    background-color: #1A1A1A;
    border-bottom: 1px solid #333333;
}

QLabel#cpTitle {
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
}

QWidget#controlPanelItem {
    border-radius: 8px;
    margin: 2px 8px;
}

QWidget#controlPanelItem:hover {
    background-color: #2C2C2C;
}

QWidget#controlPanelItem:disabled {
    opacity: 0.5;
}

QLabel#cpItemText {
    color: #E0E0E0;
}

QWidget#controlPanelItem:disabled QLabel#cpItemText,
QWidget#controlPanelItem:disabled QLabel#cpItemIcon {
    color: #555555;
}

/* ===== Empty Placeholder ===== */
QLabel#emptyLabel {
    color: #424242;
    font-size: 18px;
    font-weight: 300;
}
